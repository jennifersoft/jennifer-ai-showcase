# 제니퍼 뷰서버 주소 (예: https://jennifer.example.com)
JENNIFER_URL=
# 제니퍼 OPEN_API 토큰 (서버에서만 사용, 브라우저에 노출하지 않음)
JENNIFER_API_TOKEN=
# 이 서버 페이지를 iframe으로 넣을 수 있는 origin (공백 구분). 제니퍼 도메인을 넣는다.
FRAME_ANCESTORS='self'
# 서버 지표 데이터 소스 (기본: 공개 Prometheus 데모). 응답이 없으면 lib/prometheus-fallback.json 사용
PROMETHEUS_URL=https://prometheus.demo.prometheus.io
# PagerDuty REST API 키(읽기 전용 권장). 없으면 인시던트 위젯은 샘플 데이터로 표시
PAGERDUTY_API_KEY=
# 특정 서비스만 보려면 서비스 ID
PAGERDUTY_SERVICE_ID=
# 배포 이벤트 POST 인증용 비밀값 (CI에서 Bearer로 보냄)
DEPLOY_WEBHOOK_SECRET=
# 데모용 GitHub 릴리즈를 타임라인에 함께 표시할 저장소 (예: prometheus/prometheus)
DEPLOY_GITHUB_REPO=
# GitHub API 호출 한도를 늘리려면 (선택)
GITHUB_TOKEN=
# 슬라이드 라이브 화면에 띄울 제니퍼 사용자정의 대시보드 주소 (예: https://jennifer.example.com/userdefine/dashboard?key=...&layout=iframe)
JENNIFER_DASHBOARD_URL=

# 통합 대시보드 왼쪽 큰 칸의 제니퍼 차트 iframe 주소 (예: X-View chartIframe)
JENNIFER_CHART_URL=
